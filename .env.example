# Example environment. Copy to `.env` or export these before `node server.js`.
# Every value below is a default; the file exists to document what can change.
# Variables the addon reads are listed here — nothing here is required.

# ── Where this listens ──────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Which catalogues are asked, in priority order ───────────────────────────
#   tidal      Tidal, via Monochrome's public index. No credentials. ~1.6 s.
#   netease    NetEase Cloud Music. NetEase's own search (album + duration) and
#              Meting for audio, br=2000, so FLAC where NetEase has it and MP3
#              otherwise. No account. This is the NetEase source: the older
#              NeteaseCloudMusicApi source is gone, and its `netease:` ids are
#              accepted as an alias for this one.
#   monochrome Public instances of the same index, plus DASH/preview handling.
#   qobuz      Hi-Res, via a relay or your own qobuz-rest-api. See below.
#   archive    Internet Archive. No credentials. Freely-licensed recordings.
#   deezer     Catalogue only — no audio, so its rows fail over to the others.
#
# An unknown name here is reported at startup rather than silently dropped.
# `SOURCES=tidal` is the fastest configuration and the one to use when you are
# asking whether FLAC plays at all, rather than whether the addon is thorough.
SOURCES=qobuz,monochrome,netease,tidal,archive
# SOURCES=qobuz,monochrome,netease,tidal,archive,deezer
# SOURCES=netease

# ── The Tidal-backed index ──────────────────────────────────────────────────
# Repoint this if the public instance moves. No code change required.
TIDAL_BASE_URL=https://tracks.monochrome.st

# ── NetEase (optional) ──────────────────────────────────────────────────────
# A Meting API instance. The public instance carries a VIP cookie server-side,
# so `br=2000` returns FLAC where NetEase has one and falls back to MP3.
NETEASEV2_API_BASE=https://api.qijieya.cn/meting
# NETEASEV2_SERVER=netease

# NetEase's own search, unsigned. It is the primary search path because one
# request returns the album and duration — Meting's rows have neither, and the
# album then costs a second round trip. Set it empty to always search Meting.
NETEASEV2_SEARCH_BASE=https://music.163.com/api/search/get
# NetEase's detail endpoint, used by the Meting fallback to fill in the album
# and by nothing else. It has a 2 s budget: a missing album never costs a row.
NETEASEV2_DETAIL_BASE=https://music.163.com/api/song/detail

# ── Qobuz (optional) ────────────────────────────────────────────────────────
# The public relay is only as current as its own session, and its first request
# after idle can be slow. This value comes from the code, deliberately: a relay
# baked into a doc goes stale silently. Point QOBUZ_REST_API at your own
# qobuz-rest-api instance to get Hi-Res on your own account — it is preferred
# over the relay whenever it is set.
QOBUZ_UPSTREAM_BASE_URL=https://losslessbridge.de.deplexo.com/u/tpg000.vxrtcq1VeQcF0m1koi0Ncw.ThwpJfA6x3aCvX1oGq5iV_
# QOBUZ_REST_API=http://localhost:3000

# ── Monochrome (optional) ───────────────────────────────────────────────────
# The modern API. The public instances are read from the official registry at
# runtime; this only repoints the one host the addon asks first.
MONOCHROME_BASE_URL=https://tracks.monochrome.st

# ── Deezer (optional) ───────────────────────────────────────────────────────
# Catalogue only: rows are emitted, audio is not. No credentials.
# DEEZER_API_BASE=https://api.deezer.com

# ── Audio delivery ──────────────────────────────────────────────────────────
# 0 (default) — BitChord opens the upstream URL directly. Nothing to proxy, no
#              bandwidth here, one less thing to fail.
# 1          — audio is served through this host, which gives a real `.flac`
#              path and an `audio/flac` content type. Costs your bandwidth.
PROXY=0

# ── Access ──────────────────────────────────────────────────────────────────
# If set, every route requires ?token=<value>. BitChord keeps the token from the
# URL you paste and appends it to later calls, so you only type it once.
# Generate one with: openssl rand -hex 16
# ADDON_TOKEN=

# ── Tooling only (never read by the server) ─────────────────────────────────
# `npm run check` — where to look, and what to search for as a probe.
# ADDON_URL=http://localhost:8787
# CHECK_QUERY=Daft Punk One More Time
#
# `node src/scripts/tidal-login.js` — device-flow tokens. The defaults are a
# public client id; a token is not what this addon uses to resolve Tidal (it
# asks the public index), so these are only needed if you point the script at a
# different client.
# TIDAL_CLIENT_ID=
# TIDAL_CLIENT_SECRET=
# TIDAL_AUTH_BASE_URL=https://auth.tidal.com/v1/oauth2
